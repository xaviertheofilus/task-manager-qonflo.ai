{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?taskPath=:path*" },
    { "source": "/tasks/:id", "destination": "/index.html" },
    { "source": "/tasks", "destination": "/index.html" },
    { "source": "/board", "destination": "/index.html" },
    { "source": "/timeline", "destination": "/index.html" },
    { "source": "/users", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/trash", "destination": "/index.html" }
  ]
}
